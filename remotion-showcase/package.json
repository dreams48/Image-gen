{
  "name": "claude-motion-showcase",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render ClaudeShowcase ../output/claude_motion_showcase.mp4",
    "render:projets": "remotion render ProjetsClaude ../output/projets_claude_tutoriel.mp4",
    "voiceover": "python3 scripts/voiceover.py",
    "sfx": "python3 scripts/sfx.py 50",
    "render:whatsapp": "remotion render ProjetsWhatsApp ../output/projets_claude_whatsapp_9x16.mp4 && ffmpeg -loglevel error -y -i ../output/projets_claude_whatsapp_9x16.mp4 -c:v copy -af loudnorm=I=-16:TP=-1.5:LRA=11 -ar 48000 -c:a aac -b:a 192k ../output/tmp_master.mp4 && mv ../output/tmp_master.mp4 ../output/projets_claude_whatsapp_9x16.mp4",
    "still": "remotion still ClaudeShowcase ../output/preview_showcase.png --frame=60"
  },
  "dependencies": {
    "@fontsource/anton": "^5.1.0",
    "@fontsource/fraunces": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@remotion/cli": "^4.0.536",
    "@remotion/paths": "^4.0.536",
    "@remotion/shapes": "^4.0.536",
    "@remotion/transitions": "^4.0.536",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.536"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
